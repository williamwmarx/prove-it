$hyp "f" (TLA.isAFcn r)
$hyp "d" (= (TLA.DOMAIN r) (TLA.set "l1" "l2" "l3" "l4" "l5" "l6" "l7" "l8"))
$hyp "h1" (TLA.in (TLA.fapply r "l1") s1)
$hyp "h2" (TLA.in (TLA.fapply r "l2") s2)
$hyp "h3" (TLA.in (TLA.fapply r "l3") s3)
$hyp "h4" (TLA.in (TLA.fapply r "l4") s4)
$hyp "h5" (TLA.in (TLA.fapply r "l5") s5)
$hyp "h6" (TLA.in (TLA.fapply r "l6") s6)
$hyp "h7" (TLA.in (TLA.fapply r "l7") s7)
$hyp "h8" (TLA.in (TLA.fapply r "l8") s8)
$goal (TLA.in r (TLA.recordset "l1" s1 "l2" s2 "l3" s3 "l4" s4 "l5" s5 "l6" s6 "l7" s7 "l8" s8))
