@!!BEGIN
@!!type:obligation
@!!id:1
@!!loc:19:1:19:3
@!!status:to be proved
@!!obl:ASSUME NEW VARIABLE u,
       NEW VARIABLE v,
       NEW VARIABLE z,
       I!En ==
         ?EnabledWrapper(LAMBDA r#0, r#1 :
                           r#1 = z + 1 /\ r#0 = z - 1
                           /\ ~(/\ r#1 = z
                                /\ r#0 = z)),
       I!WFair ==
         <>[]?EnabledWrapper(LAMBDA r#0, r#1 :
                               r#1 = z + 1 /\ r#0 = z - 1
                               /\ ~(/\ r#1 = z
                                    /\ r#0 = z))
         => []<><<I!Next>>_I!vars,
       PTL 
PROVE  I!WFair <=> (<>[]I!En => []<><<I!Next>>_I!vars)

@!!END

