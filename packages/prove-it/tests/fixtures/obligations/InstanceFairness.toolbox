                               r#1 = u + 1 /\ r#0 = v - 1
                               /\ ~(/\ r#1 = u
                                    /\ r#0 = v))
         => []<><<J!Next>>_J!vars,
       PTL 
PROVE  J!SFair <=> ([]<>J!En => []<><<J!Next>>_J!vars)

@!!END

