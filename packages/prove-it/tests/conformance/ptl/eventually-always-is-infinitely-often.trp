and([
or([NVV1]), 
or([NVV4]),
always(or([not NVV2, NVV3])), 
always(or([not NVV3, p])), 
always(or([not NVV5, NVV6])), 
always(or([not NVV6, not p])),
always(or([not NVV3, next(NVV3)])), 
always(or([not NVV6, next(NVV6)])),
always(or([not NVV1, sometime(NVV2)])), 
always(or([not NVV4, sometime(NVV5)]))]).

