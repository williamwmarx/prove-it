and([
or([NVV1, NVV4]), 
or([NVV2, NVV4]), 
or([NVV1, NVV5]), 
or([NVV2, NVV5]),
always(or([not p, q])), 
always(or([not q, p])), 
always(or([not NVV1, p])), 
always(or([not NVV3, not q])), 
always(or([not NVV4, q])), 
always(or([not NVV6, not p])),
always(or([not NVV1, next(NVV1)])), 
always(or([not NVV4, next(NVV4)])),
always(or([not NVV2, sometime(NVV3)])), 
always(or([not NVV5, sometime(NVV6)]))]).

