  n4 :> (n1 :> 0 @@ n2 :> 0 @@ n3 :> 0 @@ n4 :> 0) )
/\ log = ( n1 :>
      << [ term |-> 1,
           command |-> NewConfigCommand,
           value |-> [id |-> 1, members |-> {n1, n2, n3}] ] >> @@
  n2 :>
      << [ term |-> 1,
           command |-> NewConfigCommand,
           value |-> [id |-> 1, members |-> {n1, n2, n3}] ] >> @@
  n3 :>
      << [ term |-> 1,
           command |-> NewConfigCommand,
           value |-> [id |-> 1, members |-> {n1, n2, n3}] ] >> @@
  n4 :> <<>> )
/\ pendingResponse = ( n1 :> (n1 :> FALSE @@ n2 :> FALSE @@ n3 :> FALSE @@ n4 :> FALSE) @@
  n2 :> (n1 :> FALSE @@ n2 :> FALSE @@ n3 :> FALSE @@ n4 :> FALSE) @@
