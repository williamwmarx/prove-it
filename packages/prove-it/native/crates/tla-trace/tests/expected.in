/\ state = (n1 :> Leader @@ n2 :> Follower @@ n3 :> Follower @@ n4 :> NotMember)
/\ electionCtr = 0
/\ restartCtr = 0
/\ commitIndex = (n1 :> 1 @@ n2 :> 1 @@ n3 :> 1 @@ n4 :> 0)
/\ config = ( n1 :>
