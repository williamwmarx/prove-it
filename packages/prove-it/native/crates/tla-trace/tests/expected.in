        jointConsensus |-> FALSE,
        id |-> 1,
        members |-> {n1, n2, n3} ] @@
  n2 :>
      [ committed |-> TRUE,
        jointConsensus |-> FALSE,
        id |-> 1,
        members |-> {n1, n2, n3} ] @@
  n3 :>
