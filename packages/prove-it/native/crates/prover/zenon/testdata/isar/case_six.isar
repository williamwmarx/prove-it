(* PROOF-FOUND *)
(* BEGIN-PROOF *)
proof (rule zenon_nnpp)
have zenon_case6 :
  "!! P c1x e1x c2x e2x c3x e3x c4x e4x c5x e5x c6x e6x .
    P (CASE c1x -> e1x [] c2x -> e2x [] c3x -> e3x [] c4x -> e4x [] c5x -> e5x [] c6x -> e6x) ==>
    (c1x ==> P (e1x) ==> FALSE) ==>
    (c2x ==> P (e2x) ==> FALSE) ==>
    (c3x ==> P (e3x) ==> FALSE) ==>
    (c4x ==> P (e4x) ==> FALSE) ==>
    (c5x ==> P (e5x) ==> FALSE) ==>
    (c6x ==> P (e6x) ==> FALSE) ==>
    (~c6x & ~c5x & ~c4x & ~c3x & ~c2x & ~c1x & TRUE ==> FALSE) ==>
    FALSE"
proof -
  fix P c1x e1x c2x e2x c3x e3x c4x e4x c5x e5x c6x e6x
  assume h: "P (CASE c1x -> e1x [] c2x -> e2x [] c3x -> e3x [] c4x -> e4x [] c5x -> e5x [] c6x -> e6x)"
            (is "P (?cas)")
  assume h1: "c1x ==> P (e1x) ==> FALSE"
  assume h2: "c2x ==> P (e2x) ==> FALSE"
  assume h3: "c3x ==> P (e3x) ==> FALSE"
  assume h4: "c4x ==> P (e4x) ==> FALSE"
  assume h5: "c5x ==> P (e5x) ==> FALSE"
  assume h6: "c6x ==> P (e6x) ==> FALSE"
  assume hoth: "~c6x & ~c5x & ~c4x & ~c3x & ~c2x & ~c1x & TRUE ==> FALSE"
  def cs == "<<c1x, c2x, c3x, c4x, c5x, c6x>>" (is "?cs")
  def es == "<<e1x, e2x, e3x, e4x, e5x, e6x>>" (is "?es")
  def arms == "UNION {CaseArm (?cs[i], ?es[i]) : i \\in DOMAIN ?cs}"
              (is "?arms")
  def cas == "?cas"
  have h0: "P (cas)" using h by (fold cas_def)
  def dcs == "c6x | c5x | c4x | c3x | c2x | c1x" (is "?dcs")
  show FALSE
  proof (rule zenon_em [of "?dcs"])
    assume ha: "~(?dcs)"
    have hh1: "~c1x" using ha by blast
    have hh2: "~c2x" using ha by blast
    have hh3: "~c3x" using ha by blast
    have hh4: "~c4x" using ha by blast
    have hh5: "~c5x" using ha by blast
    have hh6: "~c6x" using ha by blast
    show FALSE
      using hoth hh1 hh2 hh3 hh4 hh5 hh6 by blast
  next
    assume ha: "?dcs"
    def scs == "zenon_seqify (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (
                               <<>>, c1x), c2x), c3x), c4x), c5x), c6x))"
               (is "?scs")
    def ses == "zenon_seqify (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (zenon_appseq (
                               <<>>, e1x), e2x), e3x), e4x), e5x), e6x))"
               (is "?ses")
    have ha1: "\<exists> i \<in> DOMAIN ?scs : ?scs[i]"
      using ha zenon_case_seq_empty
      by (simp only: zenon_case_seq_simpl zenon_seqify_empty, blast)
    have ha2: "\<exists> i \<in> DOMAIN ?cs : ?cs[i]"
      using ha1 by (simp only: zenon_seqify_appseq zenon_seqify_empty)
    have hb: "\\E x : x \\in arms"
      using zenon_case_domain [OF ha2, where es = "?es"]
      by (unfold arms_def, blast)
    have hc: "(CHOOSE x : x \\in arms) \\in arms"
      using hb by (unfold Ex_def, auto)
    have hf0: "?cas \\in arms"
      using hc by (unfold arms_def, fold Case_def)
    have hf3: "cas \\in UNION {CaseArm (?scs[i], ?ses[i])
                                  : i \\in DOMAIN ?scs}"
              (is "?hf3")
      using hf0 by (fold cas_def, unfold arms_def,
                    simp only: zenon_seqify_appseq zenon_seqify_empty)
    have hf4: "Len (?scs) = Len (?ses)" (is "?hf4")
      by (simp only: zenon_case_len_simpl)
    have hf5: "?hf4 & ?hf3"
      by (rule conjI [OF hf4 hf3])
    have hf: "
               cas \\in CaseArm (c6x, e6x)
             | cas \\in CaseArm (c5x, e5x)
             | cas \\in CaseArm (c4x, e4x)
             | cas \\in CaseArm (c3x, e3x)
             | cas \\in CaseArm (c2x, e2x)
             | cas \\in CaseArm (c1x, e1x)
             | cas \\in UNION {CaseArm (zenon_seqify (<<>>)[i],
                                          zenon_seqify (<<>>)[i])
                                 : i \\in DOMAIN zenon_seqify (<<>>)}
             " (is "_ | ?gxx")
      using hf5 by (simp only: zenon_case_union_simpl, blast)
    have hg1x: "cas \\in CaseArm (c1x, e1x) => FALSE"
      using h0 h1 by auto
    have hg2x: "cas \\in CaseArm (c2x, e2x) => FALSE"
      using h0 h2 by auto
    have hg3x: "cas \\in CaseArm (c3x, e3x) => FALSE"
      using h0 h3 by auto
    have hg4x: "cas \\in CaseArm (c4x, e4x) => FALSE"
      using h0 h4 by auto
    have hg5x: "cas \\in CaseArm (c5x, e5x) => FALSE"
      using h0 h5 by auto
    have hg6x: "cas \\in CaseArm (c6x, e6x) => FALSE"
      using h0 h6 by auto
    from hf
    have hh0: "?gxx" (is "_ | ?g4")
      by (rule zenon_disjE1 [OF _ hg6x])
    then have hh4: "?g4" (is "_ | ?g3")
      by (rule zenon_disjE1 [OF _ hg5x])
    then have hh3: "?g3" (is "_ | ?g2")
      by (rule zenon_disjE1 [OF _ hg4x])
    then have hh2: "?g2" (is "_ | ?g1")
      by (rule zenon_disjE1 [OF _ hg3x])
    then have hh1: "?g1" (is "_ | ?g0")
      by (rule zenon_disjE1 [OF _ hg2x])
    then have hh0: "?g0"
      by (rule zenon_disjE1 [OF _ hg1x])
    have hi: "cas \\in UNION {CaseArm (<<>>[i], <<>>[i])
                                 : i \\in DOMAIN <<>>}"
      using hh0 by (simp only: zenon_seqify_empty)
    show FALSE
      by (rule zenon_case_empty_union [OF hi])
  qed
qed
 have z_Ha:"(c1|(c2|(c3|(c4|(c5|c6)))))" (is "_|?z_hj")
 using c by blast
 have z_Hg:"P(a6)" (is "?z_hg")
 using a6 by blast
 have z_Hf:"P(a5)" (is "?z_hf")
 using a5 by blast
 have z_He:"P(a4)" (is "?z_he")
 using a4 by blast
 have z_Hd:"P(a3)" (is "?z_hd")
 using a3 by blast
 have z_Hc:"P(a2)" (is "?z_hc")
 using a2 by blast
 have z_Hb:"P(a1)" (is "?z_hb")
 using a1 by blast
 assume z_Hh:"(~P((CASE c1 -> a1 [] c2 -> a2 [] c3 -> a3 [] c4 -> a4 [] c5 -> a5 [] c6 -> a6)))" (is "~?z_hy")
 show FALSE
 proof (rule zenon_or [OF z_Ha])
  assume z_Hi:"c1"
  show FALSE
  proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
   assume z_Hi:"c1"
   assume z_Hbe:"(~?z_hb)"
   show FALSE
   by (rule notE [OF z_Hbe z_Hb])
  next
   assume z_Hk:"c2"
   assume z_Hbf:"(~?z_hc)"
   show FALSE
   by (rule notE [OF z_Hbf z_Hc])
  next
   assume z_Hm:"c3"
   assume z_Hbg:"(~?z_hd)"
   show FALSE
   by (rule notE [OF z_Hbg z_Hd])
  next
   assume z_Ho:"c4"
   assume z_Hbh:"(~?z_he)"
   show FALSE
   by (rule notE [OF z_Hbh z_He])
  next
   assume z_Hq:"c5"
   assume z_Hbi:"(~?z_hf)"
   show FALSE
   by (rule notE [OF z_Hbi z_Hf])
  next
   assume z_Hr:"c6"
   assume z_Hbj:"(~?z_hg)"
   show FALSE
   by (rule notE [OF z_Hbj z_Hg])
  next
   assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
   have z_Hbm: "?z_hbm" (is "?z_hbn&?z_hbo")
   by (rule zenon_and_1 [OF z_Hbk])
   have z_Hbo: "?z_hbo" (is "?z_hbp&?z_hbq")
   by (rule zenon_and_1 [OF z_Hbm])
   have z_Hbq: "?z_hbq" (is "?z_hbr&?z_hbs")
   by (rule zenon_and_1 [OF z_Hbo])
   have z_Hbs: "?z_hbs" (is "?z_hbt&?z_hbu")
   by (rule zenon_and_1 [OF z_Hbq])
   have z_Hbu: "?z_hbu" (is "?z_hbv&?z_hbw")
   by (rule zenon_and_1 [OF z_Hbs])
   have z_Hbv: "?z_hbv"
   by (rule zenon_and_0 [OF z_Hbu])
   show FALSE
   by (rule notE [OF z_Hbv z_Hi])
  qed
 next
  assume z_Hj:"?z_hj" (is "_|?z_hl")
  show FALSE
  proof (rule zenon_or [OF z_Hj])
   assume z_Hk:"c2"
   show FALSE
   proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
    assume z_Hi:"c1"
    assume z_Hbe:"(~?z_hb)"
    show FALSE
    by (rule notE [OF z_Hbe z_Hb])
   next
    assume z_Hk:"c2"
    assume z_Hbf:"(~?z_hc)"
    show FALSE
    by (rule notE [OF z_Hbf z_Hc])
   next
    assume z_Hm:"c3"
    assume z_Hbg:"(~?z_hd)"
    show FALSE
    by (rule notE [OF z_Hbg z_Hd])
   next
    assume z_Ho:"c4"
    assume z_Hbh:"(~?z_he)"
    show FALSE
    by (rule notE [OF z_Hbh z_He])
   next
    assume z_Hq:"c5"
    assume z_Hbi:"(~?z_hf)"
    show FALSE
    by (rule notE [OF z_Hbi z_Hf])
   next
    assume z_Hr:"c6"
    assume z_Hbj:"(~?z_hg)"
    show FALSE
    by (rule notE [OF z_Hbj z_Hg])
   next
    assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
    have z_Hbm: "?z_hbm" (is "?z_hbn&?z_hbo")
    by (rule zenon_and_1 [OF z_Hbk])
    have z_Hbo: "?z_hbo" (is "?z_hbp&?z_hbq")
    by (rule zenon_and_1 [OF z_Hbm])
    have z_Hbq: "?z_hbq" (is "?z_hbr&?z_hbs")
    by (rule zenon_and_1 [OF z_Hbo])
    have z_Hbs: "?z_hbs" (is "?z_hbt&?z_hbu")
    by (rule zenon_and_1 [OF z_Hbq])
    have z_Hbt: "?z_hbt"
    by (rule zenon_and_0 [OF z_Hbs])
    show FALSE
    by (rule notE [OF z_Hbt z_Hk])
   qed
  next
   assume z_Hl:"?z_hl" (is "_|?z_hn")
   show FALSE
   proof (rule zenon_or [OF z_Hl])
    assume z_Hm:"c3"
    show FALSE
    proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
     assume z_Hi:"c1"
     assume z_Hbe:"(~?z_hb)"
     show FALSE
     by (rule notE [OF z_Hbe z_Hb])
    next
     assume z_Hk:"c2"
     assume z_Hbf:"(~?z_hc)"
     show FALSE
     by (rule notE [OF z_Hbf z_Hc])
    next
     assume z_Hm:"c3"
     assume z_Hbg:"(~?z_hd)"
     show FALSE
     by (rule notE [OF z_Hbg z_Hd])
    next
     assume z_Ho:"c4"
     assume z_Hbh:"(~?z_he)"
     show FALSE
     by (rule notE [OF z_Hbh z_He])
    next
     assume z_Hq:"c5"
     assume z_Hbi:"(~?z_hf)"
     show FALSE
     by (rule notE [OF z_Hbi z_Hf])
    next
     assume z_Hr:"c6"
     assume z_Hbj:"(~?z_hg)"
     show FALSE
     by (rule notE [OF z_Hbj z_Hg])
    next
     assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
     have z_Hbm: "?z_hbm" (is "?z_hbn&?z_hbo")
     by (rule zenon_and_1 [OF z_Hbk])
     have z_Hbo: "?z_hbo" (is "?z_hbp&?z_hbq")
     by (rule zenon_and_1 [OF z_Hbm])
     have z_Hbq: "?z_hbq" (is "?z_hbr&?z_hbs")
     by (rule zenon_and_1 [OF z_Hbo])
     have z_Hbr: "?z_hbr"
     by (rule zenon_and_0 [OF z_Hbq])
     show FALSE
     by (rule notE [OF z_Hbr z_Hm])
    qed
   next
    assume z_Hn:"?z_hn" (is "_|?z_hp")
    show FALSE
    proof (rule zenon_or [OF z_Hn])
     assume z_Ho:"c4"
     show FALSE
     proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
      assume z_Hi:"c1"
      assume z_Hbe:"(~?z_hb)"
      show FALSE
      by (rule notE [OF z_Hbe z_Hb])
     next
      assume z_Hk:"c2"
      assume z_Hbf:"(~?z_hc)"
      show FALSE
      by (rule notE [OF z_Hbf z_Hc])
     next
      assume z_Hm:"c3"
      assume z_Hbg:"(~?z_hd)"
      show FALSE
      by (rule notE [OF z_Hbg z_Hd])
     next
      assume z_Ho:"c4"
      assume z_Hbh:"(~?z_he)"
      show FALSE
      by (rule notE [OF z_Hbh z_He])
     next
      assume z_Hq:"c5"
      assume z_Hbi:"(~?z_hf)"
      show FALSE
      by (rule notE [OF z_Hbi z_Hf])
     next
      assume z_Hr:"c6"
      assume z_Hbj:"(~?z_hg)"
      show FALSE
      by (rule notE [OF z_Hbj z_Hg])
     next
      assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
      have z_Hbm: "?z_hbm" (is "?z_hbn&?z_hbo")
      by (rule zenon_and_1 [OF z_Hbk])
      have z_Hbo: "?z_hbo" (is "?z_hbp&?z_hbq")
      by (rule zenon_and_1 [OF z_Hbm])
      have z_Hbp: "?z_hbp"
      by (rule zenon_and_0 [OF z_Hbo])
      show FALSE
      by (rule notE [OF z_Hbp z_Ho])
     qed
    next
     assume z_Hp:"?z_hp"
     show FALSE
     proof (rule zenon_or [OF z_Hp])
      assume z_Hq:"c5"
      show FALSE
      proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
       assume z_Hi:"c1"
       assume z_Hbe:"(~?z_hb)"
       show FALSE
       by (rule notE [OF z_Hbe z_Hb])
      next
       assume z_Hk:"c2"
       assume z_Hbf:"(~?z_hc)"
       show FALSE
       by (rule notE [OF z_Hbf z_Hc])
      next
       assume z_Hm:"c3"
       assume z_Hbg:"(~?z_hd)"
       show FALSE
       by (rule notE [OF z_Hbg z_Hd])
      next
       assume z_Ho:"c4"
       assume z_Hbh:"(~?z_he)"
       show FALSE
       by (rule notE [OF z_Hbh z_He])
      next
       assume z_Hq:"c5"
       assume z_Hbi:"(~?z_hf)"
       show FALSE
       by (rule notE [OF z_Hbi z_Hf])
      next
       assume z_Hr:"c6"
       assume z_Hbj:"(~?z_hg)"
       show FALSE
       by (rule notE [OF z_Hbj z_Hg])
      next
       assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
       have z_Hbm: "?z_hbm" (is "?z_hbn&?z_hbo")
       by (rule zenon_and_1 [OF z_Hbk])
       have z_Hbn: "?z_hbn"
       by (rule zenon_and_0 [OF z_Hbm])
       show FALSE
       by (rule notE [OF z_Hbn z_Hq])
      qed
     next
      assume z_Hr:"c6"
      show FALSE
      proof (rule zenon_case6 [of "(\<lambda>zenon_Vf. (~P(zenon_Vf)))", OF z_Hh])
       assume z_Hi:"c1"
       assume z_Hbe:"(~?z_hb)"
       show FALSE
       by (rule notE [OF z_Hbe z_Hb])
      next
       assume z_Hk:"c2"
       assume z_Hbf:"(~?z_hc)"
       show FALSE
       by (rule notE [OF z_Hbf z_Hc])
      next
       assume z_Hm:"c3"
       assume z_Hbg:"(~?z_hd)"
       show FALSE
       by (rule notE [OF z_Hbg z_Hd])
      next
       assume z_Ho:"c4"
       assume z_Hbh:"(~?z_he)"
       show FALSE
       by (rule notE [OF z_Hbh z_He])
      next
       assume z_Hq:"c5"
       assume z_Hbi:"(~?z_hf)"
       show FALSE
       by (rule notE [OF z_Hbi z_Hf])
      next
       assume z_Hr:"c6"
       assume z_Hbj:"(~?z_hg)"
       show FALSE
       by (rule notE [OF z_Hbj z_Hg])
      next
       assume z_Hbk:"((~c6)&((~c5)&((~c4)&((~c3)&((~c2)&((~c1)&TRUE))))))" (is "?z_hbl&?z_hbm")
       have z_Hbl: "?z_hbl"
       by (rule zenon_and_0 [OF z_Hbk])
       show FALSE
       by (rule notE [OF z_Hbl z_Hr])
      qed
     qed
    qed
   qed
  qed
 qed
qed
(* END-PROOF *)
