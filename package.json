{
  "name": "prove-it-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @atemp/prove-it build",
    "test": "bun run --filter @atemp/prove-it test",
    "typecheck": "bun run --filter @atemp/prove-it typecheck",
    "lint": "bunx bun@1.4.4-canary.20261022.1 lint --no-script",
    "lint:fix": "bunx bun@1.4.4-canary.20261022.1 lint --no-script --fix",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check"
  },
  "packageManager": "bun@1.4.4"
}
