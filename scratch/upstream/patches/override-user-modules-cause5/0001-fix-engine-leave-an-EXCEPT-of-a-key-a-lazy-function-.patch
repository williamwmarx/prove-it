diff --git a/packages/prove-it/native/crates/tla-engine/src/compile/lazy_function.rs b/packages/prove-it/native/crates/tla-engine/src/compile/lazy_function.rs
index efc119a2..cc45fb79 100644
--- a/packages/prove-it/native/crates/tla-engine/src/compile/lazy_function.rs
+++ b/packages/prove-it/native/crates/tla-engine/src/compile/lazy_function.rs
@@ -101,10 +101,11 @@ pub(crate) fn except(machine: &mut Machine<'_>, function: Id, key: Id, value: Id
         return machine.store.except(function, key, value);
     }
     // TLC reads the function at the key first (`FcnLambdaValue.select`): outside its domain the
-    // EXCEPT changes nothing, and inside it the function's value there is evaluated, and may
-    // fail.
+    // EXCEPT changes nothing, but TLC warns that it was applied to non-existing fields (`Tool`'s
+    // OPCODE_exc), which the engine leaves to the reference interpreter as the store does for
+    // any other function. Inside it the function's value there is evaluated, and may fail.
     if !is_in_domain(machine, function, key)? {
-        return Ok(function);
+        return Err(Bail("EXCEPT outside the domain"));
     }
     apply_lazy(machine, function, key)?;
     let lazy = &machine.lazy_functions[machine.store.lazy_index_of(function) as usize];
diff --git a/packages/prove-it/native/crates/tla-trace/src/eval.rs b/packages/prove-it/native/crates/tla-trace/src/eval.rs
index 7e124fc3..b08298e8 100644
--- a/packages/prove-it/native/crates/tla-trace/src/eval.rs
+++ b/packages/prove-it/native/crates/tla-trace/src/eval.rs
@@ -4002,12 +4002,28 @@ impl<'ir> Evaluator<'ir> {
             return self.evaluate(update, &inner);
         };
         let key = self.except_key(step, context)?;
-        // `FcnLambdaValue.takeExcept`: the EXCEPT is kept, whatever the key, and `@` is the
-        // function's value at it.
+        // `FcnLambdaValue.select`, then `takeExcept`: the EXCEPT is kept, and `@` is the
+        // function's value at the key, where an earlier EXCEPT names the key or its domain holds
+        // it. Elsewhere TLC leaves the function as it is and warns, as of any other function.
         if let Value::Lambda(lambda) = value {
             if !rest.is_empty() {
                 return fail("an EXCEPT of a lazy function past its first key");
             }
+            let mut is_excepted = false;
+            for (excepted, _) in &lambda.excepts {
+                if equals(excepted, &key)? {
+                    is_excepted = true;
+                    break;
+                }
+            }
+            if !is_excepted && !self.member(&key, &lambda.domain)? {
+                self.except_skips += 1;
+                return if self.ir.model.is_warning_enabled {
+                    fail(EXCEPT_OF_MISSING_KEY)
+                } else {
+                    Ok(value.clone())
+                };
+            }
             let at = self.apply_lambda(lambda, &key)?;
             let next = self.except(&at, rest, update, context)?;
             let mut excepts = lambda.excepts.clone();
