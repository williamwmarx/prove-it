 .../specification-let-instance/Inner.tla      |  4 +++
 .../specification-let-instance/M.cfg          |  3 ++
 .../specification-let-instance/M.tla          | 12 +++++++
 .../specification-let-instance/declined       |  1 +
 .../native/crates/tla-front/src/live.rs       | 11 +++++-
 .../native/crates/tla-front/src/spec.rs       | 35 +++++++++++++++++--
 6 files changed, 62 insertions(+), 4 deletions(-)
