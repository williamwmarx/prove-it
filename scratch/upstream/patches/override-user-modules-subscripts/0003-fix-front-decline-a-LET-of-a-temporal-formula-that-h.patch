             let bound = bind_definitions(definitions, scope)?;
             return recurse(body, bound.as_ref(), substitution, found);
         }
@@ -1400,8 +1418,19 @@ impl SubscriptCollector<'_, '_> {
                 return Ok(true);
             }
             ExpressionKind::Let {
-                definitions, body, ..
+                definitions,
+                instances,
+                body,
