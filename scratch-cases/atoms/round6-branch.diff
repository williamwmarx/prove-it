+// Runs each case of a directory of tests/ at 1 and 4 workers: a directory of modules with M.cfg
+// (or the root module `root` names, and its configuration), any Java class beside them, TLC's
+// output at d8fb231 in tlc.txt, and, in cases.txt, the status TLC exits with and whether the binary
+// prints that exactly ("match") or declines ("decline").
+fn check_recorded(cases: &str, count: usize) {
+    let directory = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests")
+        .join(cases);
+    let listed = std::fs::read_to_string(directory.join("cases.txt")).expect("the cases");
+    assert_eq!(listed.lines().count(), count);
+    for line in listed.lines() {
+        let [name, code, verdict] = line.split(' ').collect::<Vec<_>>()[..] else {
+            panic!("a case: {line}");
+        };
+        let code: i32 = code.parse().expect("a code");
+        let case = directory.join(name);
+        // A case names its root module in `root` where it isn't M.
+        let root = std::fs::read_to_string(case.join("root"))
+            .map(|root| root.trim().to_owned())
+            .unwrap_or_else(|_| "M".to_owned());
+        for workers in ["1", "4"] {
+            let run = std::env::temp_dir().join(format!(
+                "prove-it-cli-{cases}-{name}-{workers}-{}",
+                std::process::id()
+            ));
+            std::fs::create_dir_all(&run).expect("a directory");
+            for entry in std::fs::read_dir(&case).expect("the case") {
+                let path = entry.expect("an entry").path();
+                if matches!(
+                    path.extension().and_then(|it| it.to_str()),
+                    Some("tla" | "cfg" | "class")
+                ) {
+                    std::fs::copy(&path, run.join(path.file_name().expect("a name")))
+                        .expect("copied");
+                }
+            }
+            let output = Command::new(env!("CARGO_BIN_EXE_prove-it"))
+                .args([
+                    "-noTE",
+                    "-workers",
+                    workers,
+                    "-nowarning",
+                    "-seed",
+                    "4",
+                    "-fp",
+                    "0",
+                ])
+                .arg(&root)
+                .current_dir(&run)
+                .output()
+                .expect("the binary runs");
+            let text = stdout(&output);
+            let error = String::from_utf8_lossy(&output.stderr).into_owned();
+            match verdict {
+                "decline" => assert!(
+                    error.contains("prove-it: not native yet: "),
+                    "{name} {workers}: {text}{error}"
+                ),
+                "match" => {
+                    let tlc = std::fs::read_to_string(case.join("tlc.txt")).expect("TLC's output");
+                    assert_eq!(get_untimed(&text), tlc, "{name} {workers}: {error}");
+                    assert_eq!(output.status.code(), Some(code), "{name} {workers}");
+                }
+                _ => panic!("a verdict: {verdict}"),
+            }
+            std::fs::remove_dir_all(run).expect("removed");
+        }
+    }
+}
